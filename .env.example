APP_ENV=production
APP_DEBUG=false
APP_URL=https://feitojunto.com
APP_SECRET=gere_uma_chave_aleatoria_de_64_caracteres_aqui

# Proxy Reverso / Cloudflare (defina true apenas se o servidor estiver atrás de proxy confiável)
TRUST_PROXY_HEADERS=false

# Banco de Dados SQLite (Padrão)
DB_CONNECTION=sqlite
DB_PATH=data/feito.sqlite

# Banco de Dados MySQL (Opcional)
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=feito_cms
# DB_USERNAME=usuario_banco
# DB_PASSWORD=senha_forte_aqui

# Credenciais Iniciais do Seed (Altere antes do primeiro deploy)
ADMIN_INITIAL_EMAIL=admin@feitojunto.com
ADMIN_INITIAL_PASSWORD=AltereEstaSenhaForte!2026

# Destinatários das notificações de leads
ADMIN_NOTIFICATION_EMAIL=gabriel@feitojunto.com,contato@feitojunto.com
MAIL_FROM_EMAIL=noreply@feitojunto.com
MAIL_FROM_NAME="feito. Notificações"

# Políticas de Segurança e Sessão
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_LIFETIME_HOURS=6

